{
  "description": "Blocks imports that break the module boundaries in ARCHITECTURE.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-module-boundaries.sh\""
          }
        ]
      }
    ]
  }
}
