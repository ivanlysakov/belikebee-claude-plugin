{
  "description": "Blocks imports that break the module boundaries in ARCHITECTURE.md, raw colors and text sizes in markup, and commits whose changed modules fail their tests.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-module-boundaries.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-design-tokens.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/test-changed-modules.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
